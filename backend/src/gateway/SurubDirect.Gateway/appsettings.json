{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp.ReverseProxy": "Warning"
    }
  },
  "AllowedHosts": "localhost;127.0.0.1",
  "ReverseProxy": {
    "Routes": {
      "identity": {
        "ClusterId": "identity",
        "Match": {
          "Path": "/api/auth/{**rest}"
        }
      },
      "inventory-receipt": {
        "ClusterId": "inventory",
        "Match": {
          "Path": "/api/v1/admin/variants/{id}/receipts"
        }
      },
      "catalog-public": {
        "ClusterId": "catalog",
        "Match": {
          "Path": "/api/v1/products/{**rest}"
        }
      },
      "catalog-categories": {
        "ClusterId": "catalog",
        "Match": {
          "Path": "/api/v1/categories"
        }
      },
      "catalog-products-admin": {
        "ClusterId": "catalog",
        "Match": {
          "Path": "/api/v1/admin/products/{**rest}"
        }
      },
      "catalog-prices-admin": {
        "ClusterId": "catalog",
        "Match": {
          "Path": "/api/v1/admin/offers/{**rest}"
        }
      },
      "ordering": {
        "ClusterId": "ordering",
        "Match": {
          "Path": "/api/v1/ordering/{**rest}"
        }
      },
      "openapi-catalog": {
        "ClusterId": "catalog",
        "Match": {
          "Path": "/openapi/catalog/v1.json"
        },
        "Transforms": [
          {
            "PathSet": "/openapi/v1.json"
          }
        ]
      },
      "openapi-inventory": {
        "ClusterId": "inventory",
        "Match": {
          "Path": "/openapi/inventory/v1.json"
        },
        "Transforms": [
          {
            "PathSet": "/openapi/v1.json"
          }
        ]
      },
      "openapi-identity": {
        "ClusterId": "identity",
        "Match": {
          "Path": "/openapi/identity/v1.json"
        },
        "Transforms": [
          {
            "PathSet": "/openapi/v1.json"
          }
        ]
      },
      "catalog-taxonomy": {
        "ClusterId": "catalog",
        "Match": {
          "Path": "/api/v1/taxonomy"
        }
      },
      "catalog-taxonomy-admin": {
        "ClusterId": "catalog",
        "Match": {
          "Path": "/api/v1/admin/taxonomy/{**rest}"
        }
      },
      "purchasing-admin": {
        "ClusterId": "purchasing",
        "Match": {
          "Path": "/api/v1/admin/purchasing/{**rest}"
        }
      },
      "openapi-purchasing": {
        "ClusterId": "purchasing",
        "Match": {
          "Path": "/openapi/purchasing/v1.json"
        },
        "Transforms": [
          {
            "PathSet": "/openapi/v1.json"
          }
        ]
      },
      "inventory-adjustments": {
        "ClusterId": "inventory",
        "Match": {
          "Path": "/api/v1/admin/variants/{id}/adjustments"
        }
      },
      "inventory-movements": {
        "ClusterId": "inventory",
        "Match": {
          "Path": "/api/v1/admin/variants/{id}/movements"
        }
      },
      "ordering-admin-list": {
        "ClusterId": "ordering",
        "Match": {
          "Path": "/api/v1/admin/sales-orders",
          "Methods": [
            "GET"
          ]
        }
      },
      "ordering-admin-detail": {
        "ClusterId": "ordering",
        "Match": {
          "Path": "/api/v1/admin/sales-orders/{id}",
          "Methods": [
            "GET"
          ]
        }
      },
      "ordering-admin-cancel": {
        "ClusterId": "ordering",
        "Match": {
          "Path": "/api/v1/admin/sales-orders/{id:guid}/cancel",
          "Methods": [
            "POST"
          ]
        }
      },
      "messaging-status": {
        "ClusterId": "ordering",
        "Match": {
          "Path": "/api/v1/admin/messaging",
          "Methods": [
            "GET"
          ]
        }
      },
      "messaging-replay": {
        "ClusterId": "ordering",
        "Match": {
          "Path": "/api/v1/admin/messaging/{id:guid}/replay",
          "Methods": [
            "POST"
          ]
        }
      },
      "messaging-outbox": {
        "ClusterId": "inventory",
        "Match": {
          "Path": "/api/v1/admin/messaging/inventory-outbox",
          "Methods": [
            "GET"
          ]
        }
      },
      "messaging-broker": {
        "ClusterId": "ordering",
        "Match": {
          "Path": "/api/v1/admin/messaging/broker",
          "Methods": [
            "GET"
          ]
        }
      }
    },
    "Clusters": {
      "catalog": {
        "Destinations": {
          "primary": {
            "Address": "http://127.0.0.1:5101/"
          }
        },
        "HttpRequest": {
          "ActivityTimeout": "00:00:15"
        }
      },
      "inventory": {
        "Destinations": {
          "primary": {
            "Address": "http://127.0.0.1:5102/"
          }
        },
        "HttpRequest": {
          "ActivityTimeout": "00:00:15"
        }
      },
      "identity": {
        "Destinations": {
          "primary": {
            "Address": "http://127.0.0.1:5103/"
          }
        },
        "HttpRequest": {
          "ActivityTimeout": "00:00:15"
        }
      },
      "ordering": {
        "Destinations": {
          "primary": {
            "Address": "http://127.0.0.1:5104/"
          }
        },
        "HttpRequest": {
          "ActivityTimeout": "00:00:15"
        }
      },
      "purchasing": {
        "Destinations": {
          "primary": {
            "Address": "http://127.0.0.1:5105/"
          }
        },
        "HttpRequest": {
          "ActivityTimeout": "00:00:15"
        }
      }
    }
  }
}
