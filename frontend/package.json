{
  "name": "surub-direct-web",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve storefront",
    "start:admin": "ng serve admin",
    "build": "ng build storefront && ng build admin",
    "build:storefront": "ng build storefront",
    "build:admin": "ng build admin",
    "test:e2e": "playwright test",
    "format": "prettier --write \"src/**/*.{ts,html,scss}\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,scss}\" \"tests/**/*.ts\"",
    "serve:ssr:storefront": "node dist/storefront/server/server.mjs"
  },
  "private": true,
  "packageManager": "npm@10.8.2",
  "dependencies": {
    "@angular/cdk": "^22.2.3",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/material": "^22.2.3",
    "@angular/platform-browser": "^22.2.0",
    "@angular/platform-server": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@angular/ssr": "^22.2.3",
    "express": "^5.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.3",
    "@angular/cli": "^22.2.3",
    "@angular/compiler-cli": "^22.2.0",
    "@playwright/test": "^1.64.1",
    "@types/express": "^5.0.1",
    "@types/node": "^22.12.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2"
  }
}
