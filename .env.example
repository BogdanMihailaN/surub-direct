ADMIN_EMAIL=admin@surubdirect.local
ADMIN_PASSWORD=replace-with-strong-admin-password
CATALOG_DB_PASSWORD=generated-by-dev-db
INVENTORY_DB_PASSWORD=generated-by-dev-db
IDENTITY_DB_PASSWORD=generated-by-dev-db
ORDERING_DB_PASSWORD=generated-by-dev-db
PURCHASING_DB_PASSWORD=generated-by-dev-db
CATALOG_SERVICE_KEY=generated-by-dev-db
INVENTORY_SERVICE_KEY=generated-by-dev-db
IDENTITY_SERVICE_KEY=generated-by-dev-db

RESERVATIONS_SERVICE_KEY=generated-by-dev-db
COORDINATOR_SERVICE_KEY=generated-by-dev-db

